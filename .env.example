# Copy to .env.local for development. Every value here is optional — the app
# runs without any of them, just with lower rate limits and fewer panels.

# Solana JSON-RPC endpoint. The public mainnet default rate-limits
# getTokenLargestAccounts, which is why top_holders / concentration stay empty.
# Any keyed endpoint (a free Helius or Triton tier is enough) fills them in.
SOLANA_RPC_URL=

# GitHub API token. Unauthenticated is 60 requests/hour, which is not enough to
# ingest the linked orgs — each one costs several calls for commits, issues,
# PRs, languages and code frequency. A classic token with no scopes (public
# data only) raises the ceiling to 5,000/hour.
GITHUB_TOKEN=

# CoinGecko demo key (free, from the CoinGecko developer dashboard). Without
# it the public tier is throttled by IP at roughly 10-30 calls a minute, and
# the exchange-listings step needs two per token — so on a full run the later
# tokens' lookups fail and a newly listed one ends up with no venues at all.
# The key roughly triples the spacing budget and lets every lookup land.
COINGECKO_KEY=

# Show the "Data Coverage" panel on project pages. It reports which of our own
# sources came back empty — pipeline health, not asset research — so it is for
# development, not readers.
#   unset  -> on outside production, off in production
#   true   -> always on  (set this in .env.local)
#   false  -> always off (set this on the deployed instance)
SHOW_DATA_COVERAGE=

# Public URL of the deployed site, for absolute links in page metadata. Defaults
# to the Railway domain; set it when the site moves to a custom domain.
SITE_URL=

# Self-serve listings (/list). Wallets allowed to review the queue at
# /admin/listings, comma-separated base58 addresses. Empty means no one can.
ADMIN_WALLETS=

# Second factor for approving listings. An admin wallet must also enter this
# on /admin/listings; the unlock lasts an hour and is bound to that wallet.
# At least 16 characters — anything shorter keeps the desk locked for everyone.
ADMIN_PASSWORD=dfdfdfbsadjfhhfhejbvcdjbvehvbchervyrhjuvryeghvaev

# RPC the listing verifier reads mints from. Defaults to public mainnet-beta
# regardless of SOLANA_RPC_URL, because that variable points the invest
# sandbox at devnet and a listing is a claim about a token on mainnet. Set
# to a devnet endpoint to exercise the flow against test mints (market and
# risk checks are skipped off mainnet).
LISTINGS_RPC_URL=https://api.devnet.solana.com
