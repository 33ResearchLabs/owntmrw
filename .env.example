# Copy to .env.local for development. Every value here is optional — the app
# runs without any of them, just with lower rate limits and fewer panels.

# Solana JSON-RPC endpoint. The public mainnet default rate-limits
# getTokenLargestAccounts, which is why top_holders / concentration stay empty.
# Any keyed endpoint (a free Helius or Triton tier is enough) fills them in.
SOLANA_RPC_URL=

# GitHub API token. Unauthenticated is 60 requests/hour, which is not enough to
# ingest the linked orgs — each one costs several calls for commits, issues,
# PRs, languages and code frequency. A classic token with no scopes (public
# data only) raises the ceiling to 5,000/hour.
GITHUB_TOKEN=

# Show the "Data Coverage" panel on project pages. It reports which of our own
# sources came back empty — pipeline health, not asset research — so it is for
# development, not readers.
#   unset  -> on outside production, off in production
#   true   -> always on  (set this in .env.local)
#   false  -> always off (set this on the deployed instance)
SHOW_DATA_COVERAGE=
